{
  "name": "@dualityinstitute/entangle",
  "version": "0.1.1",
  "description": "Control a running opencode session from your phone.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/duality-institute/entangle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duality-institute/entangle.git"
  },
  "bugs": {
    "url": "https://github.com/duality-institute/entangle/issues"
  },
  "funding": "https://www.duality.institute/sponsor",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "mobile",
    "remote-control",
    "qr"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "entangle": "./dist/cli.js"
  },
  "main": "./dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js"
  },
  "files": [
    "dist",
    "entangle-mobile-ui.png",
    "DEVELOPMENT.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:server": "bun build src/plugin.ts src/cli.ts --outdir dist --target bun --format esm",
    "build": "bun run build:ui && bun run build:server && bun run scripts/check-bundle-size.ts",
    "check": "bun run typecheck && bun run build && bun test",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.18",
    "@opencode-ai/sdk": "1.18.18",
    "jsonc-parser": "3.3.1",
    "qrcode": "^1.5.4",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/pngjs": "^6.0.5",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "@vitejs/plugin-react": "^6.0.5"
  }
}
